# Prometheus, Grafana, and cAdvisor Configuration
# Copy this file to .env and update with sensitive values only
# Non-sensitive settings (paths, TZ, retention) are configured in docker-compose.yml

# SENSITIVE: Grafana Admin Password
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# SENSITIVE: Grafana SMTP Configuration (optional)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com
GF_SMTP_USER=your-email@gmail.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM_ADDRESS=grafana@example.com
GF_SMTP_FROM_NAME=Grafana
GF_SMTP_SKIP_VERIFY=false
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
